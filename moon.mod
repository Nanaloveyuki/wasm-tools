name = "Nanaloveyuki/wasm-tools"

version = "0.6.0"

readme = "README.md"

repository = "https://github.com/Nanaloveyuki/wasm-tools"

license = "Apache-2.0"

keywords = [
  "wasm",
  "webassembly",
  "ci",
  "release",
  "github-actions",
  "moonbit",
]

description = "Configurable WASM release policies, artifact preparation, and a reusable GitHub Action"

preferred_target = "wasm"

import {
  "Milky2018/wasm_core@0.19.0",
  "Milky2018/wasm_component@0.19.0",
  "moonrockz/wit@0.4.0",
  "moonbitlang/x@0.5.9",
}
