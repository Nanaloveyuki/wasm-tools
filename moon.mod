name = "Nanaloveyuki/wasm-tools"

version = "0.4.1"

readme = "README.md"

repository = "https://github.com/Nanaloveyuki/wasm-tools"

license = "Apache-2.0"

keywords = [ "wasm", "webassembly", "wat", "cli", "moonx" ]

description = "Unified WebAssembly binary toolkit for MoonBit, runnable via moonx"

preferred_target = "wasm"

import {
  "Milky2018/wasm_core@0.18.0",
  "Milky2018/wasm_component@0.18.0",
  "moonrockz/wit@0.3.0",
  "moonbitlang/async@0.22.7",
  "moonbitlang/x@0.5.7",
  "mizchi/mwac@0.2.2",
}
