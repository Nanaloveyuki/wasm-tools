name = "Nanaloveyuki/wasm-tools"

version = "0.5.1"

readme = "README.md"

repository = "https://github.com/Nanaloveyuki/wasm-tools"

license = "Apache-2.0"

keywords = [ "wasm", "webassembly", "abi", "compatibility", "moonbit" ]

description = "MoonBit WASM contract snapshots and directional compatibility checks"

preferred_target = "wasm"

import {
  "Milky2018/wasm_core@0.19.0",
  "Milky2018/wasm_component@0.19.0",
  "moonrockz/wit@0.4.0",
  "moonbitlang/async@0.22.9",
  "moonbitlang/x@0.5.7",
}
