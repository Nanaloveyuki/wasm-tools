import {
  "Nanaloveyuki/wasm-tools/cmd",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/x/sys",
}

supported_targets = "native+wasm"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/external_loop_integration",
  ],
)
