import {
  "Nanaloveyuki/wasm-tools/cli",
  "Nanaloveyuki/wasm-tools/wasm",
  "Nanaloveyuki/wasm-tools/contract",
  "Nanaloveyuki/wasm-tools/release",
  "Nanaloveyuki/wasm-tools/bundle",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string" @str,
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/x/path",
  "moonbitlang/x/crypto",
}

supported_targets = "wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/external_loop_integration",
  ],
)
