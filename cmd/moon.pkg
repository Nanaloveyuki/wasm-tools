import {
  "Nanaloveyuki/wasm-tools/cli",
  "Nanaloveyuki/wasm-tools/wasm",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string" @str,
}

supported_targets = "wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/external_loop_integration",
  ],
)
